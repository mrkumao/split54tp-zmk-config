# split54tp 用の自作機能 (2026-11-04)
#   キーマップ等に該当の compatible のノードがあるビルドでだけ有効になる
#   (settings_reset のビルドでは何もコンパイルしない)。
#   書き方は urob/zmk-adaptive-key などのモジュールと同じ。

DT_COMPAT_ZMK_BEHAVIOR_TP_CALIB_LOCAL := zmk,behavior-tp-calib-local
DT_COMPAT_ZMK_INPUT_PROCESSOR_TP_SPEED := zmk,input-processor-tp-speed
DT_COMPAT_ZMK_BEHAVIOR_TP_FIX := zmk,behavior-tp-fix
DT_COMPAT_ZMK_INPUT_PROCESSOR_TP_DRIFT := zmk,input-processor-tp-drift
DT_COMPAT_LPPS := lpps

# ★ 2026-11-14 取り込んだ LPPS のドライバ (src/pointing/lpps.c、zmk-driver-lpps 7a4a67c をもとに手を入れたもの)。
#   上流のドライバは config/split54tp.conf の CONFIG_LPPS=n でビルドから外す。devicetree の compatible "lpps" と binding は上流のまま。
#   keyboard-project/docs/rev7-修正計画.md 手順 205
config SPLIT54TP_LPPS
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_LPPS))
    depends on INPUT
    select I2C

# ★ 2026-11-14 ドライバで、X / Y それぞれ絶対値からこの値を引く (この値以下は 0)。X も Y も 0 なら入力の知らせを出さない
#   (ZMK の「操作」にも、Mac へのマウスの報告にもならない)。左右それぞれのビルドで、自分の LPPS に使う。
#   既定 2 = 左。右は boards/shields/split54tp/split54tp_right.conf で 6 (2026-11-11 までの右の input processor の dead-zone と同じ)。
# ★ 2026-11-15 引くのは X / Y 別々ではなく、力の大きさ (√(x² + y²)) から。向きはそのまま (円が四角になっていた)。
#   既定 (= 左) を 2 → 6 に (触らずに 3 分で左は最大 31 / 8 の値が出て、Mac へ動きを送り続けた。右と同じ重さにそろえる)。
#   keyboard-project/docs/rev7-修正計画.md 手順 208・209
config SPLIT54TP_LPPS_DEAD_ZONE
    int "LPPS: subtract this from the force length sqrt(x^2+y^2); do not report when it becomes 0"
    default 6
    range 0 100
    depends on SPLIT54TP_LPPS

# ★ 2026-11-15 止まっている状態から動き始めるとき、引く量を超えた読み取りがこの回数続いてから知らせる (1 回だけ跳ねた値を捨てる)。
#   1 = すぐ知らせる (前と同じ)。動かしている間の読み取りは 1 秒に約 140 回 (右の実測) なので、3 回で約 0.02 秒の遅れ
config SPLIT54TP_LPPS_START_READS
    int "LPPS: reads above the dead zone needed before reporting from rest"
    default 3
    range 1 20
    depends on SPLIT54TP_LPPS

# 押した側の LPPS を校正する (左右どちらのビルドにも要る)
# ★ 2026-11-14 depends on を LPPS → SPLIT54TP_LPPS に
config SPLIT54TP_TP_CALIB_LOCAL
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_TP_CALIB_LOCAL))
    depends on SPLIT54TP_LPPS

# ★ 2026-11-11 TP 復旧のキー (試し)。押した側の LPPS を読み直す (左右どちらのビルドにも要る)
config SPLIT54TP_TP_FIX
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_TP_FIX))
    depends on SPLIT54TP_LPPS_RESCUE

# ★ 2026-11-11 LPPS の読み直し (src/pointing/lpps_rescue.c)。LPPS がある半身で左右とも
# ★ 2026-11-14 depends on を LPPS → SPLIT54TP_LPPS に
config SPLIT54TP_LPPS_RESCUE
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_LPPS))
    depends on SPLIT54TP_LPPS && I2C && INPUT

# 自分の側の LPPS からこの時間 (ミリ秒) 動きが来なければ、この間隔で読み直す。0 = 自動の読み直しをしない。
# 2000 (2 秒) はユーザー指定 (2026-11-11)。.conf に CONFIG_SPLIT54TP_LPPS_KEEPALIVE_MS=5000 などと書けば変えられる
config SPLIT54TP_LPPS_KEEPALIVE_MS
    int "LPPS keepalive re-read interval (ms, 0 = off)"
    default 2000
    depends on SPLIT54TP_LPPS_RESCUE

# ★ 2026-11-11 (2 回目) 読み直すのは、自分の側のキーを押すかスティックが動いてから、この時間 (ミリ秒) の間だけ。
# 2 秒ごとの読み直しがずっと続くと OLED が 30 秒で消えなかった (読み直しのあとの値 0 の通知を ZMK が「操作」と数える見込み)。
# ZMK が「使っていない」とみなす時間 (CONFIG_ZMK_IDLE_TIMEOUT、既定 30000) より短くすること
# ★ 2026-11-11 (3 回目) 0 = 時間で止めず、置いている間も読み直す (案 A の試し。共通 conf で 0 にしている)
config SPLIT54TP_LPPS_KEEPALIVE_WINDOW_MS
    int "LPPS keepalive: keep re-reading for this long after the last key press or stick motion (ms)"
    default 20000
    depends on SPLIT54TP_LPPS_RESCUE

# スティックの感度を動作中に変える (セントラルだけで使う)
config SPLIT54TP_TP_SPEED
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_TP_SPEED))

# ★ 2026-11-11 スティックのドリフトを捨てる「門」(src/pointing/input_processor_tp_drift.c)。
# ノード (tp_drift_l / tp_drift_r) は右の overlay にだけあるので、右のビルドでだけ有効になる
config SPLIT54TP_TP_DRIFT
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_TP_DRIFT))
