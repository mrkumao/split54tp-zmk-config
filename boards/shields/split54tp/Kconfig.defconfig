# split54tp
#
# トラックポイントをセントラル側に置く制約があった名残で「右」をセントラルにしている。
# 低消費電力I2C版へ移行後も、この構成のままで問題ない
# (USBでキー入力を送れるのはセントラル側だけなので、右にUSBを挿す運用になる)。

if SHIELD_SPLIT54TP_LEFT

config ZMK_KEYBOARD_NAME
	default "split54tp"

# ---- 状態モニタ用 OLED (2026-09-07 追加 / まずは左だけで検証) ----
#
# 右(セントラル)では J2 が TP センサに隠れていて配線できないため、
# 配線可能な左で先に検証する。左はペリフェラルなので表示できる情報が
# 限られるが、「rev.6 で左にも OLED を載せる価値があるか」を判断する
# 材料がまさにこれなので、検証としては有意義。
#
# ⚠ 共通の .conf ではなくここに置く理由:
#   ZMK_DISPLAY_BLANK_ON_IDLE 等は表示が有効な時だけ存在するシンボルで、
#   共通 conf に書くと右で依存を満たせず Kconfig 警告 → ビルド中断になる。
#   Kconfig.defconfig の default は依存を満たさない側では無視されるので安全。
#
# 検証が済んだら、この4項目を下の
#   if SHIELD_SPLIT54TP_LEFT || SHIELD_SPLIT54TP_RIGHT
# ブロックへ移して両側で有効にする。

config ZMK_DISPLAY
	default y

config I2C
	default y

config SSD1306
	default y

config ZMK_DISPLAY_BLANK_ON_IDLE
	default y

# ⚠ LV_Z_VDB_SIZE は上書きしない (ZMK 既定の 64% を使う)
#   2026-09-07 に 128x64 の表示不良の対処として 100 にしたが、
#   128x32 では動作実績のある既定値をそのまま使う方が安全。
endif

if SHIELD_SPLIT54TP_RIGHT

# 右半身をセントラル(ホスト接続側)にする
config ZMK_SPLIT_ROLE_CENTRAL
	default y

# USB出力はセントラル(右)だけが持てる。
# 共通の .conf に書くと左で依存関係を満たせず Kconfig 警告→ビルド中断になるため、
# ここ(右シールド限定)に置く。
config ZMK_USB
	default y

config ZMK_KEYBOARD_NAME
	default "split54tp"

endif

if SHIELD_SPLIT54TP_LEFT || SHIELD_SPLIT54TP_RIGHT

config ZMK_SPLIT
	default y

# EC11 ロータリーエンコーダ
config EC11
	default y

# ⚠ EC11_TRIGGER_GLOBAL_THREAD は choice(三択)のメンバーなので
#   ここで default y を書いても効かず、Kconfig 警告→ビルド中断になる。
#     "defaults do not affect choice symbols"
#   選択は config/split54tp.conf 側の CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y で行う。

# マウスクリック/スクロール (&mkp / &msc)。ポインティングデバイスは不要。
config ZMK_POINTING
	default y

endif
