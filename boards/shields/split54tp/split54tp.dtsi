/*
 * split54tp - 共通デバイスツリー
 *
 * 物理配列: メイン 6列×4行 ＋ 親指3キー ＝ 27キー/半身 (計54キー)
 * エンコーダ: スクロールホイール型(横軸/マウスホイール方式)
 *           内側の第7列ストリップに CPU / スティック / エンコーダを配置
 *
 * チャーリープレックス 7線 (L0-L6 = XIAO D0-D6)
 * 電気的マッピング RC(drive, sense):
 *   rev.6 はゴースト対策で 1 キーずつ再配置した (規則性なし)。一覧は default_transform の map を参照。
 *   (rev.5 の「通常列 drive=L4/L5/L6 / 反転列 drive=行」は廃止。旧記述は .bak-rev6map-20260926)
 *   エンコーダプッシュ: RC(2,1)
 *   → 28ペア/半身。右半身は col-offset 7
 *
 * ZMK公式の charlieplex ドライバ仕様との整合を 2026-08-24 に検証済み:
 *   「row は常に駆動ピン、column は常に受信ピン」「row==column は除外」
 *   https://zmk.dev/docs/config/kscan
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        /*
         * ★ ZMK Studio 対応のため zmk,matrix-transform は chosen に置かない。
         *   公式: "The keyboard should also not have a chosen zmk,matrix-transform."
         *   代わりに下の physical layout が transform を参照する。
         *   https://zmk.dev/docs/features/studio
         */
        /*
         * ⚠ zephyr,display はここに書けない。
         *   Zephyr は **デバイスツリーを Kconfig より先に処理する** ため、
         *   .dtsi / .overlay の前処理時点で CONFIG_* はまだ存在しない。
         *   #ifdef CONFIG_ZMK_DISPLAY は常に偽になる (2026-09-07 に実機ビルドで判明)。
         *   → OLED 関連は split54tp_left.overlay に無条件で書いている。
         */
    };

    /*
     * 物理レイアウト (ZMK Studio がキーの配置を描画するのに必要)
     *   単位は centi-keyunit (1キー = 100)。<&key_physical_attrs 幅 高 X Y 回転 rx ry>
     *   X/Y はキーの左上。オーソリニア19.05mm等ピッチなので、
     *   PCBのスイッチ実座標から機械的に生成した (2026-08-29)。
     *   左半身 X=0〜600 / 右半身 X=740〜1340 (左右の間隔 1.40キーユニット = 26.67mm)
     *   並び順はキーマップの bindings と完全に一致している。
     */
    default_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "split54tp";
        transform = <&default_transform>;
            /* num   */
          keys = <&key_physical_attrs 100 100    0    0 0 0 0>
                , <&key_physical_attrs 100 100  100    0 0 0 0>
                , <&key_physical_attrs 100 100  200    0 0 0 0>
                , <&key_physical_attrs 100 100  300    0 0 0 0>
                , <&key_physical_attrs 100 100  400    0 0 0 0>
                , <&key_physical_attrs 100 100  500    0 0 0 0>
                , <&key_physical_attrs 100 100  840    0 0 0 0>
                , <&key_physical_attrs 100 100  940    0 0 0 0>
                , <&key_physical_attrs 100 100 1040    0 0 0 0>
                , <&key_physical_attrs 100 100 1140    0 0 0 0>
                , <&key_physical_attrs 100 100 1240    0 0 0 0>
                , <&key_physical_attrs 100 100 1340    0 0 0 0>
            /* upper */
                , <&key_physical_attrs 100 100    0  100 0 0 0>
                , <&key_physical_attrs 100 100  100  100 0 0 0>
                , <&key_physical_attrs 100 100  200  100 0 0 0>
                , <&key_physical_attrs 100 100  300  100 0 0 0>
                , <&key_physical_attrs 100 100  400  100 0 0 0>
                , <&key_physical_attrs 100 100  500  100 0 0 0>
                , <&key_physical_attrs 100 100  840  100 0 0 0>
                , <&key_physical_attrs 100 100  940  100 0 0 0>
                , <&key_physical_attrs 100 100 1040  100 0 0 0>
                , <&key_physical_attrs 100 100 1140  100 0 0 0>
                , <&key_physical_attrs 100 100 1240  100 0 0 0>
                , <&key_physical_attrs 100 100 1340  100 0 0 0>
            /* home  */
                , <&key_physical_attrs 100 100    0  200 0 0 0>
                , <&key_physical_attrs 100 100  100  200 0 0 0>
                , <&key_physical_attrs 100 100  200  200 0 0 0>
                , <&key_physical_attrs 100 100  300  200 0 0 0>
                , <&key_physical_attrs 100 100  400  200 0 0 0>
                , <&key_physical_attrs 100 100  500  200 0 0 0>
                , <&key_physical_attrs 100 100  840  200 0 0 0>
                , <&key_physical_attrs 100 100  940  200 0 0 0>
                , <&key_physical_attrs 100 100 1040  200 0 0 0>
                , <&key_physical_attrs 100 100 1140  200 0 0 0>
                , <&key_physical_attrs 100 100 1240  200 0 0 0>
                , <&key_physical_attrs 100 100 1340  200 0 0 0>
            /* lower */
                , <&key_physical_attrs 100 100    0  300 0 0 0>
                , <&key_physical_attrs 100 100  100  300 0 0 0>
                , <&key_physical_attrs 100 100  200  300 0 0 0>
                , <&key_physical_attrs 100 100  300  300 0 0 0>
                , <&key_physical_attrs 100 100  400  300 0 0 0>
                , <&key_physical_attrs 100 100  500  300 0 0 0>
                , <&key_physical_attrs 100 100  840  300 0 0 0>
                , <&key_physical_attrs 100 100  940  300 0 0 0>
                , <&key_physical_attrs 100 100 1040  300 0 0 0>
                , <&key_physical_attrs 100 100 1140  300 0 0 0>
                , <&key_physical_attrs 100 100 1240  300 0 0 0>
                , <&key_physical_attrs 100 100 1340  300 0 0 0>
            /* thumb */
                , <&key_physical_attrs 100 100  400  400 0 0 0>
                , <&key_physical_attrs 100 100  500  400 0 0 0>
                , <&key_physical_attrs 100 100  600  400 0 0 0>
                , <&key_physical_attrs 100 100  740  400 0 0 0>
                , <&key_physical_attrs 100 100  840  400 0 0 0>
                , <&key_physical_attrs 100 100  940  400 0 0 0>
            /* エンコーダのプッシュ 左|右 */
                , <&key_physical_attrs 100 100  600  295 0 0 0>
                , <&key_physical_attrs 100 100  740  295 0 0 0>
          ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        gpios
            = <&xiao_d 0 GPIO_ACTIVE_HIGH>   /* L0 */
            , <&xiao_d 1 GPIO_ACTIVE_HIGH>   /* L1 */
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>   /* L2 */
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>   /* L3 */
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>   /* L4 */
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>   /* L5 */
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>   /* L6 */
            ;

        /*
         * interrupt-gpios を設定すると割込みスキャンになり消費電力が大きく下がる。
         * ただし容量が n(n-1)=42 から (n-1)(n-2)=30 へ減る (使用28なので余裕2)。
         * 割込みピンには全sense線をダイオードORで接続する必要があり、
         * かつ空きピンが無いため現状は未使用 (ポーリング動作)。
         */
    };

    /* 7行(drive) x 14列(sense: 0-6=左, 7-13=右) / 56キーポジション */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <7>;
        columns = <14>;
        /*
         * ★ 2026-09-26 rev.6 基板の配線割当に差し替え (ゴースト対策で再配置した割当)。
         *   出典: keyboard-project/docs/rev6-課題一覧.md「default_transform の map」、
         *   および ergogen/output_rev6_fpc の .kicad_pcb から S1〜S27 と D の
         *   ネットを抽出して左右 27 キーすべて一致を確認済み。
         *   rev.5 の旧 map は split54tp.dtsi.bak-rev6map-20260926 に残してある。
         *   右半身は左の鏡像 (同じローカル RC、sense に +7)。
         */
        map = <
/* num   : ESC 1 2 3 4 5   |   6 7 8 9 0 DEL */
RC(5,2)   RC(2,6)   RC(2,5)   RC(4,5)   RC(6,2)   RC(3,2)      RC(3,9)   RC(6,9)   RC(4,12)  RC(2,12)  RC(2,13)  RC(5,9)
/* upper : TAB Q W E R T   |   Y U I O P BSPC */
RC(1,6)   RC(3,6)   RC(0,1)   RC(1,5)   RC(6,4)   RC(6,1)      RC(6,8)   RC(6,11)  RC(1,12)  RC(0,8)   RC(3,13)  RC(1,13)
/* home  : CTRL A S D F G  |   H J K L ; ENTER */
RC(3,0)   RC(4,6)   RC(3,5)   RC(6,3)   RC(5,1)   RC(5,4)      RC(5,11)  RC(5,8)   RC(6,10)  RC(3,12)  RC(4,13)  RC(3,7)
/* lower : SHIFT Z X C V B |   N M , . / SHIFT */
RC(0,3)   RC(1,2)   RC(4,2)   RC(5,3)   RC(2,4)   RC(2,3)      RC(2,10)  RC(2,11)  RC(5,10)  RC(4,9)   RC(1,9)   RC(0,10)
/* thumb : 左3キー(out/mid/in) | 右3キー(in/mid/out)   ※ out=index / mid=inner / in=strip */
                                                      RC(1,0)   RC(0,4)   RC(4,0)      RC(4,7)   RC(0,11)  RC(1,7)
/* ホイール プッシュ 左 | 右 */
RC(2,1)                                             RC(2,8)
        >;
    };

    /*
     * スクロールホイール型エンコーダ (横軸 = マウスホイール方式)
     * ZMKから見ればEC11と同じ2相インクリメンタルなので alps,ec11 ドライバで扱える。
     * 各overlayで status = "okay" にする。
     *
     * ⚠ steps / triggers-per-rotation は THQWGD001C の実分解能が未確認。
     *   実機で回してみて、1ノッチあたりのスクロール量が合うよう調整すること。
     * ★ 2026-09-26 rev.6 (CKW12): steps 30 では 1ノッチで2回トリガした (ログで確認)。
     *   steps を 60 にして 1ノッチ=1トリガにする (triggers-per-rotation は 15 のまま)。
     *   CKW12 の公式資料にパルス数の記載はない。多すぎ/少なすぎなら 30/120 を試す。
     *
     * ⚠ 右基板は ENC1 を物理的に180度回転させて実装している (PWR1/RST1との干渉回避)。
     *   そのため右だけ回転方向が逆になる可能性がある。
     *   逆だった場合は split54tp_right.overlay で a-gpios/b-gpios を入れ替える。
     */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <60>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <15>;
    };

    /*
     * ---- ポインティングスティック (低消費電力I2C版 / LPPS) ---- 2026-09-26 有効化
     *   モジュール: https://github.com/sekigon-gonnoc/low-power-pointing-stick
     *   ドライバ  : https://github.com/sekigon-gonnoc/zmk-driver-lpps
     *   ZMK 公式の split パターン: https://zmk.dev/docs/hardware-integration/pointing
     *
     * 配線 (rev.6):
     *   J1 (FPC 6P) … 1 VCC / 2 MOTION / 3 NC / 4 SCL / 5 SDA / 6 GND
     *   SCL/SDA = D10 / D9 (I2C 共用バス, 4.7kΩ R1/R2)。OLED(0x3C) と LPPS(0x57) が同居
     *   MOTION  = NFC1 (P0.09) … XIAO 裏面パッドからリード線 (中継パッド 18)
     *
     * 左 (ペリフェラル): lpps → lpps_split 経由でセントラルへ転送
     * 右 (セントラル)  : lpps_split_listener で左の分を受け、lpps_listener で自分の分を受ける
     */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        lpps_split: lpps_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    /* 左スティック用 (右で okay にする) */
    lpps_split_listener: lpps_split_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&lpps_split>;
    };
};

/*
 * ---- NFC パッドを GPIO として使う ----
 * P0.09 / P0.10 は既定で NFC アンテナ端子。GPIO として使うには UICR の設定が要る。
 *
 * ⚠ Zephyr 4.1 移行で Kconfig の CONFIG_NFCT_PINS_AS_GPIOS は削除された。
 *   現在は下記の devicetree 設定を使う。
 *   https://zmk.dev/blog/2025/12/09/zephyr-4-1
 *
 * ⚠ この設定は P0.09 を LPPS の MOTION に使うために必要。
 *
 * ⚠ P0.09 / P0.10 は nRF52840 データシート上
 *   「Standard drive, low frequency I/O only」= **10kHz まで** に分類される。
 *   割込み入力(MOTION)のような実質 DC の用途は問題ないが、
 *   **I2C(100〜400kHz) や WS2812 をここに割り当ててはいけない。**
 *   https://infocenter.nordicsemi.com/topic/ps_nrf52840/pin.html
 */
&uicr {
    nfct-pins-as-gpios;
};

/*
 * ---- OLED はここには書かない ----
 * デバイスツリーは Kconfig より先に処理されるため、この共通 dtsi で
 * #ifdef CONFIG_ZMK_DISPLAY による出し分けはできない。
 * OLED を載せる側の overlay (現在は split54tp_left.overlay) に無条件で書くこと。
 */

/*
 * ---- I2C バス (D9 = SDA / D10 = SCL) ---- 2026-09-26 左 overlay から移設
 *   rev.6 は左右とも同じバスに OLED(0x3C) と LPPS(0x57) が載るので共通化した。
 *   OLED ノードは左 overlay にだけ置く（右は OLED 未有効）。
 *
 * ⚠ 基板側の i2c1_default は D4/D5 (= キーマトリクス L4/L5)。
 *   同名上書きをやめて別名ノードを &i2c1 から明示的に指す (2026-09-08 の教訓)。
 * ⚠ xiao_ble の spi2 は D8/D9/D10 を掴んでいるので無効化必須 (2026-09-08 の根本原因)。
 */
&pinctrl {
    i2c1_oled_default: i2c1_oled_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 14)>, <NRF_PSEL(TWIM_SCL, 1, 15)>;
        };
    };

    i2c1_oled_sleep: i2c1_oled_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 14)>, <NRF_PSEL(TWIM_SCL, 1, 15)>;
            low-power-enable;
        };
    };
};

&spi2 {
    status = "disabled";
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    /*
     * ★ 2026-09-26 400kHz (FAST) に変更。ドライバ README の例と同じ値。
     *   100kHz では右 LPPS で「Motion detected → 約500ms 後に I2C read failed: -5」
     *   (転送タイムアウト) が多発した。MOTION がローの短い間に読み切るため速くする。
     *   OLED の 100kHz 化はブレッドボード配線時の暫定策だった (PCB 本組みでは不要の見込み)。
     *   戻すときは I2C_BITRATE_STANDARD。
     */
    /*
     * ★ 2026-09-26 (2回目) 100kHz に戻して比較中。
     *   400kHz では生データが常に 00 00 0x (X/Y 常に0、Z も 3〜10 しか動かない)。
     *   100kHz では失敗は多いが X/Y に値が出ていた (DF E0 00 / AC AC 2A)。
     */
    clock-frequency = <I2C_BITRATE_STANDARD>;
    pinctrl-0 = <&i2c1_oled_default>;
    pinctrl-1 = <&i2c1_oled_sleep>;
    pinctrl-names = "default", "sleep";

    /*
     * LPPS (sekigon-gonnoc)。irq-gpios はドライバ README どおり GPIO_PULL_UP のみ。
     * ドライバは生の値で「0 = MOTION アクティブ」と判定するので ACTIVE_LOW を付けない。
     */
    lpps: pointing_device@57 {
        compatible = "lpps";
        reg = <0x57>;
        irq-gpios = <&gpio0 9 GPIO_PULL_UP>;
    };
};
