/*
 * split54tp - 共通デバイスツリー
 *
 * 物理配列: メイン 6列×4行 ＋ 親指3キー ＝ 27キー/半身 (計54キー)
 * エンコーダ: スクロールホイール型(横軸/マウスホイール方式)
 *           内側の第7列ストリップに CPU / スティック / エンコーダを配置
 *
 * チャーリープレックス 7線 (L0-L6 = XIAO D0-D6)
 * 電気的マッピング RC(drive, sense):
 *   通常列 outer/pinky/ring  : drive=L4/L5/L6, sense=L0(num)/L1(upper)/L2(home)/L3(lower)
 *   反転列 middle/index/inner: drive=L0/L1/L2/L3(行), sense=L4/L5/L6(列)
 *   親指3キー: index=(4,5) inner=(4,6) strip=(5,6)
 *   エンコーダプッシュ: (0,1)
 *   → 28ペア/半身。右半身は col-offset 7
 *
 * ZMK公式の charlieplex ドライバ仕様との整合を 2026-08-24 に検証済み:
 *   「row は常に駆動ピン、column は常に受信ピン」「row==column は除外」
 *   https://zmk.dev/docs/config/kscan
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        /*
         * ★ ZMK Studio 対応のため zmk,matrix-transform は chosen に置かない。
         *   公式: "The keyboard should also not have a chosen zmk,matrix-transform."
         *   代わりに下の physical layout が transform を参照する。
         *   https://zmk.dev/docs/features/studio
         */
/*
 * ---- NFC パッドを GPIO として使う ----
 * P0.09 / P0.10 は既定で NFC アンテナ端子。GPIO として使うには UICR の設定が要る。
 *
 * ⚠ Zephyr 4.1 移行で Kconfig の CONFIG_NFCT_PINS_AS_GPIOS は削除された。
 *   現在は下記の devicetree 設定を使う。
 *   https://zmk.dev/blog/2025/12/09/zephyr-4-1
 *
 * ⚠ この設定は OLED 用ではなく **P0.09 を LPPS の MOTION に使うため** に必要。
 *   そのため #ifdef CONFIG_ZMK_DISPLAY の外に出してある (2026-09-07 移動)。
 *
 * ⚠ P0.09 / P0.10 は nRF52840 データシート上
 *   「Standard drive, low frequency I/O only」= **10kHz まで** に分類される。
 *   割込み入力(MOTION)のような実質 DC の用途は問題ないが、
 *   **I2C(100〜400kHz) や WS2812 をここに割り当ててはいけない。**
 *   https://infocenter.nordicsemi.com/topic/ps_nrf52840/pin.html
 */
&uicr {
    nfct-pins-as-gpios;
};

#ifdef CONFIG_ZMK_DISPLAY
/*
 * ---- 状態モニタ用 OLED ----
 *   秋月電子 通販コード 112031 / SUNHOKEY
 *   0.96インチ **128 x 64** 白色 / 制御IC **SSD1315**(旧ロットは SSD1306) / I2C
 *   外形 27.0 x 24.7mm / 電源 3〜5V / ピン 4本 (GND / VDD / SCK / SDA)
 *   https://akizukidenshi.com/catalog/g/g112031/
 *
 * ⚠ 2026-09-07 修正: 以前は 128x32 の設定だった。実物は 128x64 なので
 *   height / multiplex-ratio を変更し、com-sequential を削除した。
 *   com-sequential は「COM ピンの配線が sequential」を意味する 128x32 用の指定で、
 *   128x64 モジュールは alternative 配線のため付けてはいけない(表示が化ける)。
 *
 * ⚠ 2026-09-07 修正: I2C を P0.09/P0.10 から **D9/D10** へ移した。
 *   P0.09/P0.10 は低周波 I/O 専用(10kHz まで)で、I2C の速度域に使えない。
 *   D9 = P1.14 (SDA) / D10 = P1.15 (SCL)。
 *   プルアップ 4.7kΩ (R1/R2) は D9/D10 に実装済みなのでそのまま使える。
 *
 * ⚠ LPPS (ポインティングスティック 0x57) も同じ D9/D10 に載る。
 *   **必ず同一の i2c ノードの下に両方を書くこと。**
 *   別ノードに分けると同じピンを2つのペリフェラルが奪い合って動かない。
 */
&pinctrl {
    i2c1_default: i2c1_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 14)>, <NRF_PSEL(TWIM_SCL, 1, 15)>;
        };
    };
    i2c1_sleep: i2c1_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 14)>, <NRF_PSEL(TWIM_SCL, 1, 15)>;
            low-power-enable;
        };
    };
};

&i2c1 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c1_default>;
    pinctrl-1 = <&i2c1_sleep>;
    pinctrl-names = "default", "sleep";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
#endif /* CONFIG_ZMK_DISPLAY */
