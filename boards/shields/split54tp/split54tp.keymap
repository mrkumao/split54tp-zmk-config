/*
 * split54tp デフォルトキーマップ (US配列 / 手書きレイアウト図準拠)
 * 54キー + ホイールエンコーダのプッシュ2 = 56ポジション
 *
 *  ┌─────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬─────┐
 *  │ ESC │  1  │  2  │  3  │  4  │  5  │   │  6  │  7  │  8  │  9  │  0  │  -  │  (2026-11-01: DEL → -。DEL は L1 + BS)
 *  ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
 *  │ TAB │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │ BS  │
 *  ├─────┼─────┼─────┼─────┼─────┼─────┤ ◉ ├─────┼─────┼─────┼─────┼─────┼─────┤  ◉=スティック
 *  │CTRL │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  ;  │ ENT │
 *  ├─────┼─────┼─────┼─────┼─────┼─────┤ ≡ ├─────┼─────┼─────┼─────┼─────┼─────┤  ≡=スクロールホイール
 *  │SHIFT│  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │SHIFT│
 *  └─────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┴─────┴─────┘
 *                    │ALT  │SPC  │ L1  │   │ L2  │SPC  │ALT  │
 *                    └─────┴─────┴─────┘   └─────┴─────┴─────┘
 *
 * ★ ZMK Studio 対応ビルドです (右=セントラルのみ)。
 *   https://zmk.studio/ に接続すると、再ビルドなしでキー割当を変更できます。
 *   変更するには、まず &studio_unlock を押してロックを解除します。
 *     L2 + Tab位置 … 左半身  (2026-11-01 変更)
 *     L2 + BS位置  … 右半身  (2026-11-01 変更)
 *   ⚠ 切断するか、Studio上で一定時間操作しないと再びロックされる。
 *     https://zmk.dev/docs/keymaps/behaviors/studio-unlock
 *
 *   ⚠ 一度 Studio でキーマップを保存すると、このファイルへの変更は反映されなくなります。
 *     戻すには Studio の "Restore Stock Settings" を実行してください。
 *     以降、このファイルは「初期値」と「Studioで使えるレイヤー枠」を決めるものになります。
 *
 * ★ ファームウェア書き換え用のキー (2026-08-31 追加 / 2026-11-01 左右とも変更)
 *     L1 + X   (左手だけ) → 左半身をブートローダへ
 *     L2 + .   (右手だけ) → 右半身をブートローダへ
 *   Shift の位置は L1 / L2 を押したまま Shift + 矢印などで押しやすいので避けた。
 *   ⚠ キーマップは右で処理するので、左の書き換えにも右の電源と左右の接続が要る。
 *     https://zmk.dev/docs/features/split-keyboards

 * ★★ チャーリープレックスのゴースト (2026-09-12 実機で確定) ★★
 *
 *   内側親指 RC(5,6) を押している間、sense線5のキー (7/U/J/M) を押すと
 *   ダイオードが直列につながり、sense線6の同じ行 (6/Y/H/N) が
 *   「押された」ことになる。逆に drive線6のキー (9/O/L/.) を押すと
 *   (0/P/;//) が立つ。これは電気的な制約でファームでは直せない。
 *
 *   実害の例: L2 + M → ゴーストで N が立ち、旧配置の &bootloader が発火して
 *             右半身がブートローダに入る (2026-09-12 に3時間を費やした)
 *             L2 + J → ← に加えて H の右クリックが出る (現在も再現する)
 *
 *   【原則】内側親指と併用するレイヤーでは、次の8か所に
 *           破壊的な操作やマウスクリックを置かないこと。
 *             6 / Y / H / N  (右・global col 13)
 *             0 / P / ; / /  (右)
 *           左半身も対称に 5 / T / G / B と同等の位置が該当する。
 *
 *   【ゴースト非対象の安全な位置】(内側親指と併用しても幽霊が立たない)
 *             右: I, BSPC, ,(カンマ), 右Shift
 *           → &bootloader と &studio_unlock はここへ逃がしてある。
 *
 *   rev.6 では親指キーとメイン列の電気的マッピングを見直すこと (最重要課題)。
 *
 *   ★ 2026-09-26 rev.6 で解決: 配線割当を見直し、保持キー併用時のゴーストは
 *     すべて未使用ペアに落ちる (実機で確認)。L1/L2 の &none 退避を撤去し、
 *     ゴースト対策前 (split54tp.keymap.bak4-20260912) の配置に戻した。
 *     &bootloader(L2+BSPC) / &studio_unlock(L2+Shift) の位置は bak4 のまま。
 *     上記の説明は rev.5 の記録として残す。
 *
 *   ZMK公式: リセット系ビヘイビアは「押した側」にだけ作用する (source-specific)。
 *   そのため左右それぞれにキーが必要。コンボにすると常にセントラル(右)側で
 *   実行されてしまうため、通常のキーとして両側に置いている。
 *   https://zmk.dev/docs/keymaps/behaviors/reset
 *
 *   ⚠ これはファームが正常に起動し、キーが反応する場合にのみ使える。
 *     起動しない / 配線ミスで反応しない場合は、XIAO のリセットボタンを
 *     素早く2回押す (ハードウェア側の最後の砦)。
 *
 * エンコーダは横軸のスクロールホイール(マウスホイール方式)。
 * ※ エンコーダへの behavior 割当は ZMK Studio では未対応のため、ここで定義します。
 * 回転はマウスのホイールスクロールとして送出する (&msc SCRL_UP / SCRL_DOWN)。
 * スクロール方向が逆の場合は enc_scroll の bindings を入れ替える。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/*
 * ★ マウススクロールの速度 (既定: 10)
 *   &msc は押下時間に比例して積算する速度ベースの挙動。エンコーダは
 *   press→release が一瞬なので、既定値のままだと積算量がほぼ0になり動かない。
 *   下の scroll_dn / scroll_up マクロのホールド時間とセットで調整する。
 *   https://zmk.dev/docs/keymaps/behaviors/mouse-emulation
 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/modifiers.h>

/*
 * ★ 2026-10-31 LPPS の強制キャリブレーション (L2 + / に割当。2026-11-01 に . から移動)
 *   押すと、次に MOTION が来たときにドライバがレジスタ 0x04 に 1 を書く。そのときにスティックに触っていないこと。
 *   セントラル (右) で実行されるので、効くのは右の LPPS だけ。
 *   https://github.com/sekigon-gonnoc/zmk-driver-lpps
 */
#include <behaviors/lpps-calibration.dtsi>

/*
 * ---- レイヤー構成 ----
 *  ZMKには「BLEプロファイルごとのキーマップ」機能は存在しない。
 *  レイヤーは全プロファイル共通なので、"プロファイル切替と同時にOS用の
 *  ベースレイヤーへ移動する" マクロを組んで等価の運用を実現する。
 *
 *  &to は「デフォルトレイヤー以外を全て無効化」する仕様なので、
 *  OS別レイヤーは差分(修飾キーの入れ替え)だけを書き、
 *  残りは &trans にしてレイヤー0を透過させればよい。
 *  https://zmk.dev/docs/keymaps/behaviors/layers
 */
/*
 * ★ 2026-11-01 OS 別のレイヤーを L1 / L2 より小さい番号に変更。
 *   番号が大きいレイヤーが優先されるので、Mac / iPad が上だと L2 + 左 Space (F11) や
 *   L1 / L2 のホイールが Mac / iPad の設定に隠れる。番号は下の keymap ノードの並びと合わせること。
 *   https://zmk.dev/docs/keymaps
 */
#define BASE  0   // Windows / 会社PC (デフォルト)
#define MAC   1   // Mac      : 左 CTRL の位置 → CMD、左 Space の長押し → CTRL
#define IPAD  2   // iPad     : Mac と同じ配列 (将来分けられるよう別レイヤーにしてある)
#define LOWER 3
#define RAISE 4

/ {
    behaviors {
        /*
         * ---- BLEプロファイル切替 (CTRL + 数字キー) ----
         * ベースの 1/2/3/4 の位置に置く。レイヤー(L1/L2)上で
         *   そのまま押す        → 記号 ( - = [ ] )
         *   CTRLを押しながら    → BLEプロファイル 1〜4 に切替/ペアリング
         * keep-mods は既定の0なので、CTRLはホストへ送出されない。
         * https://zmk.dev/docs/keymaps/behaviors/mod-morph
         *
         * ZMKは既定で5プロファイルを持つが、ここでは4つだけを使う。
         * https://zmk.dev/docs/features/bluetooth#profiles
         */
        /*
         * プロファイル切替 = BLEプロファイル選択 + OS用ベースレイヤーへ移動
         *   1: Mac  / 2: Windows(会社PC) / 3: iPad / 4: 予備(Windows配列)
         */
        prof1_mac: prof1_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to MAC>;
        };
        prof2_win: prof2_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to BASE>;
        };
        prof3_ipad: prof3_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&to IPAD>;
        };
        prof4_spare: prof4_spare {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&to BASE>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&prof1_mac>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&prof2_win>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&prof3_ipad>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        bt_4: bt_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&prof4_spare>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        /*
         * ★ 2026-11-01 Mac / iPad の左 Space: 短く押すと Space、約 0.2 秒以上押すと CTRL
         *   Mac / iPad レイヤーは左 CTRL の位置が CMD になり CTRL が無くなるので、ここに置く。
         *   プロファイルの切り替えも、左 Space の長押し + L2 + 1〜4 でできる（L1 は同じ親指なので押せない）。
         *   左 Space を先に押すこと。L2 を先に押すと L2 + 左 Space = F11 になる。
         *   tap-preferred: 判定は時間だけで決まる。他のキーを一緒に押しても CTRL に早変わりしない。
         *   quick-tap-ms: 短く押してすぐ押し直すと Space のまま（押し続ければ連続入力）。
         *   https://zmk.dev/docs/keymaps/behaviors/hold-tap
         */
        ctl_spc: ctl_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        /*
         * ホイール回転 → マウススクロール
         *
         * ⚠ 2026-09-03 実機で判明: bindings に &msc を直接書くと「全く動かない」。
         *   &msc / &mmv は zmk,behavior-input-two-axis の実装で、
         *   「押している間だけ動く」速度ベースの挙動 (time-to-max-speed-ms=300 /
         *   acceleration-exponent=0)。エンコーダの回転は press→release が一瞬なので
         *   積算量がほぼ0になり、ホストへ何も送られない。
         *   (L2 の &rot_kp PG_DN PG_UP はキーイベントなので問題なく動いた)
         *
         *   → マクロで press → wait-ms → release とし、一定時間ホールドさせる。
         *
         * ★ 調整点 (実機で追い込むこと)
         *     動かない        → wait-ms を長くする / SCRL_VAL を上げる
         *     行き過ぎる      → wait-ms を短くする / SCRL_VAL を下げる
         *     速く回すと遅れる → wait-ms を短くし、SCRL_VAL を上げて補う
         *   目安: SCRL_VAL は「毎秒Nクリック」相当。1クリックに 1000/N ms かかる。
         *         SCRL_VAL=80 → 1クリック12.5ms → wait-ms=40 で1ノッチ約3.2クリック。
         *   履歴: 40/40 (約1.6クリック) は「動くが少なすぎる」→ 80 へ (2026-09-03 実機)
         *         rev.6 (CKW12) で 80/40 は「マウスより1ノッチの移動量が大きい」→ wait-ms 20 へ (2026-09-26)
         *
         * https://zmk.dev/docs/keymaps/behaviors/mouse-emulation
         */
        scroll_dn: scroll_dn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_press &msc SCRL_DOWN>, <&macro_release &msc SCRL_DOWN>;
        };
        scroll_up: scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <10>;
            bindings = <&macro_press &msc SCRL_UP>, <&macro_release &msc SCRL_UP>;
        };

        // 公式: https://zmk.dev/docs/keymaps/behaviors/sensor-rotate
        enc_scroll: enc_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&scroll_dn>, <&scroll_up>;
        };

        // 参考: キー送出にしたい場合はこちらを sensor-bindings に使う
        rot_kp: rot_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5        &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T         &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G         &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B         &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp SPACE  &mo LOWER     &mo RAISE  &kp SPACE  &kp RALT
&mkp LCLK                                                                     &mkp LCLK   // ホイールのプッシュ = 左クリック (2026-11-01)
            >;
            sensor-bindings = <&enc_scroll &enc_scroll>;
        };

        mac_layer {
            display-name = "Mac";
            /* Macの修飾キー: 左CTRLの位置→CMD / 左Spaceの長押し→CTRL。他は &trans でレイヤー0を透過 */
            bindings = <
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // num
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // upper
            &kp LGUI  &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // home : 左CTRLの位置 → CMD(GUI)
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // lower
            &trans    &ctl_spc LCTRL SPACE    &trans    &trans    &trans    &trans      // thumb: 外側は LALT(=Opt) のまま透過。左Space の長押し = CTRL
            &trans    &trans      // ホイールのプッシュ
            >;
            sensor-bindings = <&enc_scroll &enc_scroll>;
        };

        ipad_layer {
            display-name = "iPad";
            /* iPadOSもCMD系。中身はMacと同じだが、将来分けられるよう別レイヤーにしてある */
            bindings = <
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // num
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // upper
            &kp LGUI  &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // home : 左CTRLの位置 → CMD(GUI)
            &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      // lower
            &trans    &ctl_spc LCTRL SPACE    &trans    &trans    &trans    &trans      // thumb: 外側は LALT(=Opt) のまま透過。左Space の長押し = CTRL
            &trans    &trans      // ホイールのプッシュ
            >;
            sensor-bindings = <&enc_scroll &enc_scroll>;
        };

        lower_layer {
            display-name = "L1";   // OLED の表示 (2026-11-01)
            bindings = <
&kp GRAVE      &bt_1          &bt_2          &bt_3          &bt_4          &kp BSLH         &kp SQT        &kp UNDER      &kp PLUS       &kp LBRC       &kp RBRC       &kp PIPE   // 記号 (L1/L2共通)  ` - = [ ] \  |  ' _ + { } |
&kp CAPS       &trans         &mkp LCLK      &kp UP         &mkp RCLK      &kp PG_UP        &trans         &mkp LCLK      &mkp MCLK      &mkp RCLK      &trans         &kp DEL   // 左: Tab の位置=CapsLock W=左クリック E=↑ R=右クリック T=PgUp  /  右: U=左クリック I=中クリック O=右クリック、BS の位置=DEL
&trans         &kp HOME       &kp LEFT       &kp DOWN       &kp RIGHT      &kp END          &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &kp PSCRN   // 左: A=Home S← D↓ F→ G=End  /  右: F1-F5、Enter の位置=PrtSc (2026-11-01)
&trans         &trans         &bootloader    &trans         &trans         &kp PG_DN        &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &trans   // 左: X=左をブートローダへ B=PgDn  /  右: F6-F10 (2026-11-01)
                                               &kp LGUI       &trans         &trans           &kp F11        &kp F12        &kp RGUI   // thumb: 外側=GUI(Win/Cmd)。左=左GUI、右=右GUI / L2 の位置=F11 右Space=F12 (2026-11-01)
&mkp RCLK                                                                                             &mkp RCLK   // ホイールのプッシュ = 右クリック (2026-11-01)
            >;
            // 下位レイヤーではホイールを音量に
            sensor-bindings = <&rot_kp C_VOL_UP C_VOL_DN &rot_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "L2";   // OLED の表示 (2026-11-01)
            bindings = <
&kp GRAVE      &bt_1          &bt_2          &bt_3          &bt_4          &kp BSLH         &kp SQT        &kp UNDER      &kp PLUS       &kp LBRC       &kp RBRC       &kp PIPE   // 記号 (L1と同一)
&studio_unlock &out OUT_USB   &out OUT_BLE   &out OUT_TOG   &bt BT_CLR     &trans             &kp PG_UP      &mkp LCLK      &kp UP         &mkp RCLK      &trans         &studio_unlock   // 左: Tab の位置=Studio解除 R=BT消去 / 右: Y=PgUp U=左クリック I=↑ O=右クリック BS の位置=Studio解除 (2026-11-01)
&trans         &kp F1         &kp F2         &kp F3         &kp F4         &kp F5           &kp HOME       &kp LEFT       &kp DOWN       &kp RIGHT      &kp END        &kp PSCRN   // 左: F1-F5 (2026-11-01)  /  右: H=Home J← K↓ L→ ;=End Enter の位置=PrtSc
&trans         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10          &kp PG_DN      &trans         &trans         &bootloader    &ps_calib      &trans   // 左: F6-F10 / 右: N=PgDn .=右をブートローダへ /=TP校正 (2026-11-01)
                                               &kp LGUI       &kp F11        &kp F12          &trans         &trans         &kp RGUI   // thumb: 外側=GUI(Win/Cmd)。左=左GUI、右=右GUI / 左Space=F11 L1 の位置=F12 (2026-11-01)
&mkp RCLK                                                                                             &mkp RCLK   // ホイールのプッシュ = 右クリック (2026-11-01)
            >;
            // 上位レイヤーではホイールを水平スクロールに
            sensor-bindings = <&rot_kp PG_DN PG_UP &rot_kp PG_DN PG_UP>;
        };

        /*
         * ZMK Studio 用の予約レイヤー。
         * 通常ビルドでは無視され、Studio 有効ビルドでのみ使えるようになる。
         * devicetree で確保した数を超えるレイヤーは Studio では追加できないため、
         * あらかじめ余分に用意しておく。
         * https://zmk.dev/docs/features/studio#including-extra-layers
         */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
    };
};
